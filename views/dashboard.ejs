<!doctype html>
<html lang="tr">
<head><%- include('partials/head', { title: 'Dashboard / Control Center' }) %></head>
<body class="dashboard">
	<canvas class="ambient-canvas" aria-hidden="true"></canvas><div class="noise" aria-hidden="true"></div>
	<header class="topbar"><a class="brand" href="/dashboard"><span>CC</span> CONTROL CENTER</a><div class="account"><span class="account-dot"></span><span><%= user.username %></span><a href="/auth/logout">Çıkış</a></div></header>
	<main class="shell">
		<section class="intro reveal"><div><div class="eyebrow">OPERATIONS / DASHBOARD</div><h1>Komuta merkezi.</h1><p>Bağlı sunucularını yönet, davet üret ve destek kuyruğunu izle.</p></div><div class="live"><span class="pulse online"></span> LIVE <span class="live-time" data-clock></span></div></section>
		<% if (query.ok) { %><div class="notice reveal"><span class="notice-mark">✓</span><%= query.ok %></div><% } %>
		<section class="stats reveal"><div><small>BAĞLI SUNUCU</small><strong><%= guilds.length %></strong><span>Yönetilebilir ağ</span></div><div><small>AÇIK TICKET</small><strong><%= tickets.filter((ticket) => ticket.status === 'open').length %></strong><span>Destek bekliyor</span></div><div><small>SİSTEM DURUMU</small><strong class="stat-online">AKTİF</strong><span>Bot bağlantısı stabil</span></div></section>
		<section class="grid">
			<div class="panel wide reveal"><div class="panel-head"><div><small>01 / SERVERS</small><h2>Sunucular</h2></div><span class="count"><%= guilds.length %></span></div>
				<% if (!guilds.length) { %><div class="empty-state"><div class="empty-icon"><i></i><i></i><i></i></div><strong>Henüz sunucu bulunamadı</strong><p>Botu bir Discord sunucusuna eklediğinde yönetim araçları burada görünecek.</p><a class="text-link" href="/auth/login">Bağlantıyı yenile →</a></div><% } %>
				<div class="server-list"><% guilds.forEach((guild) => { %><article class="server"><div class="server-mark"><%= guild.name.slice(0, 1).toUpperCase() %></div><div class="server-copy"><strong><%= guild.name %></strong><span><%= guild.memberCount %> üye · <%= guild.channels.cache.size %> kanal</span></div><form method="post" action="/guilds/<%= guild.id %>/invites"><button class="button small" type="submit">Davet gönder ↗</button></form><form class="channel-form" method="post" action="/guilds/<%= guild.id %>/channels"><input name="name" placeholder="kanal-adı" required><input name="topic" placeholder="Konu (opsiyonel)"><button class="button small primary" type="submit">Kanal oluştur</button></form></article><% }) %></div>
			</div>
			<div class="panel reveal"><div class="panel-head"><div><small>02 / TICKETS</small><h2>Destek kuyruğu</h2></div><span class="count"><%= tickets.filter((ticket) => ticket.status === 'open').length %></span></div><div class="ticket-list"><% if (!tickets.length) { %><div class="ticket-empty"><span>+</span><p>Sunucu içinden açılan ticketlar burada görünür.</p></div><% } %><% tickets.slice(0, 8).forEach((ticket) => { %><div class="ticket"><div><strong><%= ticket.userTag %></strong><span><%= ticket.subject || `Ticket #${ticket.number || '?'}` %></span></div><% if (ticket.status === 'open') { %><form method="post" action="/tickets/<%= ticket.id %>/close"><button class="icon-button" title="Ticket kapat" type="submit">×</button></form><% } else { %><span class="closed">Kapalı</span><% } %></div><% }) %></div></div>
		</section>
		<footer class="footer"><span>CONTROL CENTER / 2026</span><span>DESIGNED FOR FOCUS</span></footer>
	</main>
</body>
</html>